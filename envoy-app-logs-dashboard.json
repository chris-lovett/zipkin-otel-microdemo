{
  "title": "Envoy & Application Logs",
  "uid": "platform-envoy-app-logs",
  "description": "HashiCups pod logs, Envoy access logs (JSON parsed), and log volume by pod",
  "tags": [
    "loki",
    "logs",
    "hashicups",
    "envoy",
    "platform"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "15s",
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "editable": true,
  "id": null,
  "links": [],
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "d6de82d8-a1c6-456c-9c92-c4ee9558a04d"
        },
        "definition": "label_values(namespace)",
        "query": "label_values(namespace)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "hide": 0,
        "refresh": 2,
        "sort": 1,
        "current": {},
        "options": []
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "d6de82d8-a1c6-456c-9c92-c4ee9558a04d"
        },
        "definition": "label_values({namespace=\"$namespace\"}, pod)",
        "query": "label_values({namespace=\"$namespace\"}, pod)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "hide": 0,
        "refresh": 2,
        "sort": 1,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "App Log Volume (lines/s)",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "d6de82d8-a1c6-456c-9c92-c4ee9558a04d"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "d6de82d8-a1c6-456c-9c92-c4ee9558a04d"
          },
          "refId": "A",
          "expr": "sum(rate({namespace=~\"$namespace\", app=~\"frontend|nginx|payments|product-api|product-api-db|public-api\", pod=~\"$pod\"}[1m]))",
          "legendFormat": "lines/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "App Error Rate (lines/s)",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "d6de82d8-a1c6-456c-9c92-c4ee9558a04d"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "d6de82d8-a1c6-456c-9c92-c4ee9558a04d"
          },
          "refId": "A",
          "expr": "sum(rate({namespace=~\"$namespace\", app=~\"frontend|nginx|payments|product-api|product-api-db|public-api\", pod=~\"$pod\"} |~ \"(?i)(error|fatal|panic)\"[1m]))",
          "legendFormat": "errors/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Envoy 5xx Rate (lines/s)",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "d6de82d8-a1c6-456c-9c92-c4ee9558a04d"
