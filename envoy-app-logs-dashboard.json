      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "d6de82d8-a1c6-456c-9c92-c4ee9558a04d"
          },
          "refId": "A",
          "expr": "sum(rate({namespace=~\"$namespace\", container=\"consul-dataplane\", pod=~\"$pod\"} | json | response_code >= 500 [1m]))",
          "legendFormat": "5xx/s"
        }
      ]
    },
